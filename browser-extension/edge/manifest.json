{
  "manifest_version": 3,
  "name": "DMate",
  "description": "在 Microsoft Edge 侧边栏中使用 DMate 离散数学智能辅学系统。",
  "version": "1.0.4",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel"
  ],
  "host_permissions": [
    "https://dmate.zeabur.app/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "打开 DMate 侧边栏",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://dmate.zeabur.app; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' blob: https:; style-src 'self' 'unsafe-inline';"
  },
  "homepage_url": "https://dmate.zeabur.app/"
}
