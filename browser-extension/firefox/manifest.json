{
  "manifest_version": 3,
  "name": "DMate",
  "version": "1.0.4",
  "description": "在 Firefox 侧边栏中使用 DMate 离散数学智能辅学系统。",
  "browser_specific_settings": {
    "gecko": {
      "id": "dmate@dmate.zeabur.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "personalCommunications",
          "personallyIdentifyingInfo"
        ]
      }
    }
  },
  "host_permissions": [
    "https://dmate.zeabur.app/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "打开 DMate 侧边栏",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "sidebar_action": {
    "default_title": "DMate - 离散数学智能辅学系统",
    "default_panel": "sidebar.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "open_at_install": false
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://dmate.zeabur.app; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' blob: https:; style-src 'self' 'unsafe-inline';"
  },
  "homepage_url": "https://dmate.zeabur.app/"
}
