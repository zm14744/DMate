# Maintainer: zm14744 <https://github.com/zm14744>
# This package repacks the upstream Linux DEB without recompiling the program.
pkgname=dmate-bin
pkgver=1.0.0
pkgrel=1
pkgdesc='AI-powered discrete mathematics learning assistant (prebuilt Tauri desktop application)'
arch=('x86_64')
url='https://dmate.zeabur.app/'
license=('unknown')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'librsvg' 'libxdo')
makedepends=('libarchive')
provides=('dmate')
source=("DMate_${pkgver}_amd64.deb::https://github.com/zm14744/DMate/releases/download/v1.0.1/DMate_1.0.0_amd64.deb")
sha256sums=('f08be966fd157465da68a0f76d316edec15199e6eac511616737c0fb6c92f307')

package() {
  local _deb="${srcdir}/DMate_${pkgver}_amd64.deb"
  local _tmp="${srcdir}/dmate-package-extract"
  local _payload

  mkdir -p "${_tmp}" "${pkgdir}"
  bsdtar -xf "${_deb}" -C "${_tmp}"

  for _payload in "${_tmp}"/data.tar.*; do
    if [[ -f "${_payload}" ]]; then
      bsdtar -xf "${_payload}" -C "${pkgdir}"
      break
    fi
  done

  if [[ ! -x "${pkgdir}/usr/bin/dmate-desktop" ]]; then
    printf 'ERROR: dmate-desktop was not found in the upstream Debian package.\n' >&2
    return 1
  fi
}
